{
  "function": "findLargest",
  "params": ["arr"],
  "tests": [
    {
      "input": [3, 7, 2, 9, 4],
      "expected": 9
    },
    {
      "input": [10, 5, 8, 2],
      "expected": 10
    },
    {
      "input": [-5, -2, -10, -1],
      "expected": -1
    },
    {
      "input": [42],
      "expected": 42
    },
    {
      "input": [1, 1, 1, 1],
      "expected": 1
    },
    {
      "input": [100, 250, 75, 999, 500],
      "expected": 999
    },
    {
      "input": [-100, -50, -25, -75],
      "expected": -25
    }
  ]
}
